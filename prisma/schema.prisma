// Schéma de la base PostgreSQL.
// Les modèles User, Session, Account et Verification sont ceux qu'attend Better Auth (`src/auth/auth.ts`) :
// ne pas renommer leurs champs sans adapter sa configuration.
// Après une modification : `pnpm db:migrate` (crée la migration et regénère le client).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Un compte : un nom (ou pseudo) et une adresse email unique.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Dernière fois que l'utilisateur a quitté l'application (« hors ligne depuis… »), visible de ses amis.
  lastSeenAt    DateTime?
  /// Plugin Admin de Better Auth : `user` ou `admin` (accès à l'administration).
  role          String?   @default("user")
  /// Compte suspendu : plus aucune session ne peut s'ouvrir.
  banned        Boolean?  @default(false)
  banReason     String?
  /// Fin de la suspension ; `null` : définitive.
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Relations sociales (voir plus bas)
  friendshipsAsA   Friendship[]  @relation("FriendshipUserA")
  friendshipsAsB   Friendship[]  @relation("FriendshipUserB")
  groupMemberships GroupMember[]
  ownedGroups      Group[]

  @@map("user")
}

/// Une session ouverte sur un appareil ; son jeton est porté par un cookie httpOnly.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Session ouverte par un administrateur « en tant que » cet utilisateur : son identifiant.
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

/// Moyen de connexion rattaché à un compte (fournisseur OAuth, mot de passe…).
/// Inutilisé pour la connexion par email seul, mais requis par Better Auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Jetons temporaires de Better Auth (vérification d'email, etc.). Inutilisé pour l'instant.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Relations sociales ─────────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Lien d'amitié entre deux utilisateurs : une demande, puis une amitié une fois acceptée.
/// La paire est rangée dans l'ordre (userAId < userBId) : un seul lien possible par paire,
/// garanti par la base, quel que soit celui qui a fait la demande.
model Friendship {
  id          String           @id @default(cuid())
  userAId     String
  userBId     String
  /// Auteur de la demande (userAId ou userBId).
  requesterId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userA       User             @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User             @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendship")
}

/// Groupe d'amis. Son propriétaire (au départ, celui qui l'a créé) l'administre :
/// nom, photo, membres, rôles et autorisations. Pour partir, il désigne son successeur.
model Group {
  id        String        @id @default(cuid())
  name      String
  /// Nom du fichier de la photo dans le stockage des photos de groupe (voir `GroupPhotosService`).
  photo     String?
  /// Toujours un membre du groupe ; `null` seulement le temps de désigner un successeur.
  ownerId   String?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  members   GroupMember[]

  /// Ce que les simples membres peuvent faire (propriétaire et administrateurs : toujours tout).
  membersCanWrite     Boolean @default(true)
  membersCanSendVoice Boolean @default(true)
  membersCanCall      Boolean @default(true)

  @@map("friend_group")
}

/// Rôle d'un membre ; le propriétaire, lui, est désigné par `Group.ownerId`.
enum GroupRole {
  MEMBER
  /// Ajoute des membres et supprime des messages, par délégation du propriétaire.
  ADMIN
}

/// Lien entre un utilisateur et un groupe d'amis.
model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime  @default(now())
  role     GroupRole @default(MEMBER)

  /// Restrictions propres à ce membre, en plus de celles du groupe (sans effet sur un administrateur).
  canWrite     Boolean @default(true)
  canSendVoice Boolean @default(true)
  canCall      Boolean @default(true)

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_member")
}
