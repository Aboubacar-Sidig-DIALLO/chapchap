# Copier en `.env` puis compléter.

# Base PostgreSQL dédiée à cette application (ne pas partager avec un autre projet :
# `prisma migrate` y gère seul le schéma).
DATABASE_URL="postgresql://user:password@localhost:5432/chat"

# Secret de signature des cookies de session (32 caractères aléatoires au moins) :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de cette API
BETTER_AUTH_URL="http://localhost:3001"

# Origine du front (CORS, Socket.io, protection CSRF de Better Auth)
CLIENT_ORIGIN="http://localhost:3000"
